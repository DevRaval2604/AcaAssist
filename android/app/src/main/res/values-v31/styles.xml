<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Launch theme used by Android 12+ while process starts -->

    <style name="LaunchTheme" parent="@android:style/Theme.Translucent.NoTitleBar">

        <!-- Make system splash background transparent-->

        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>



        <!-- Disable the animated icon and branding image -->

        <item name="android:windowSplashScreenAnimatedIcon">@null</item>

        <item name="android:windowSplashScreenBrandingImage">@null</item>



        <!-- Remove any system animation -->

        <item name="android:windowSplashScreenAnimationDuration">0</item>

    </style>

</resources>